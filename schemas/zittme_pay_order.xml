<table name="zittme_pay_order">
	<column name="order_srl" type="bigint" notnull="notnull" primarykey="primarykey" />
	<!--
	  PG 에 넘기는 주문번호. 결제 URL 과 콜백이 이 값으로 주문을 찾으므로 유일해야 한다.
	  order_srl 을 그대로 노출하지 않는 이유는 남의 주문번호를 추측하지 못하게 하기 위해서다.
	-->
	<column name="order_code" type="varchar" size="40" notnull="notnull" unique="unique_order_code" />

	<!--
	  결제 대상의 범용 좌표. 커머스든 예약이든 이 두 값으로만 가리킨다.
	  덕분에 결제 엔진은 요청자 모듈의 테이블을 전혀 몰라도 된다.
	-->
	<column name="source_module" type="varchar" size="40" notnull="notnull" default="" />
	<column name="source_srl" type="bigint" notnull="notnull" default="0" />

	<column name="member_srl" type="bigint" notnull="notnull" default="0" index="idx_member_srl" />
	<column name="payer_name" type="varchar" size="80" />
	<column name="payer_phone" type="varchar" size="40" />
	<column name="payer_email" type="varchar" size="120" />
	<column name="title" type="varchar" size="250" />

	<column name="currency" type="varchar" size="8" notnull="notnull" default="KRW" />
	<!--
	  승인 대조의 기준 금액. 브라우저가 보낸 금액은 이 값과 일치할 때만 승인한다.
	  (보안 3원칙 1 — 금액은 서버 것만 신뢰한다)
	-->
	<column name="amount" type="bigint" notnull="notnull" default="0" />
	<!-- 부분취소 누적액. amount 에 도달하면 전액 취소된 것이다. -->
	<column name="cancelled_amount" type="bigint" notnull="notnull" default="0" />

	<column name="gateway" type="varchar" size="20" notnull="notnull" default="" index="idx_gateway" />
	<!-- PG 가 알려주는 실제 결제수단 (card / vbank / transfer …). 표시용. -->
	<column name="pay_method" type="varchar" size="30" />
	<column name="pg_tid" type="varchar" size="120" index="idx_pg_tid" />

	<!-- ready / pending / paid / cancelled / partial_cancelled / failed / expired -->
	<column name="status" type="varchar" size="20" notnull="notnull" default="ready" index="idx_status" />

	<!-- 결제 후 요청자 모듈로 돌아갈 주소. 같은 호스트만 허용한다. -->
	<column name="return_url" type="varchar" size="255" />
	<column name="ipaddress" type="varchar" size="128" />

	<!--
	  드라이버별 부가정보(JSON). 무통장 입금계좌·입금자명, 토스 카드사·영수증 URL 등
	  게이트웨이마다 다른 값이 들어간다. 조회 조건으로 쓰지 않으므로 칼럼을 늘리지 않는다.
	-->
	<column name="extra_vars" type="text" />

	<!--
	  구매확정 시각. 요청자 모듈이 "확정됐다" 고 알려 준 때다.
	  확정 조건(배송완료 며칠 후 등)은 요청자만 알기 때문에 여기서 판단하지 않는다.
	  값이 있으면 취소가 잠긴다 (관리자 강제 취소는 예외).
	-->
	<column name="confirm_date" type="char" size="14" />

	<!--
	  수동 환불 상태. PG 로 자동 취소할 수 없는 결제(무통장, 정산이 끝난 카드 등)를
	  취소했을 때 "돈을 아직 안 보냈다" 는 사실을 여기에 남긴다.
	  이 표시가 없으면 환불이 조용히 누락된다.
	  '' 해당없음 / pending 송금 대기 / done 송금 완료
	-->
	<column name="refund_state" type="varchar" size="20" notnull="notnull" default="" index="idx_refund_state" />
	<!-- 수동으로 송금해야 할 누적 금액. -->
	<column name="refund_amount" type="bigint" notnull="notnull" default="0" />
	<column name="refund_date" type="char" size="14" />

	<column name="regdate" type="char" size="14" index="idx_regdate" />
	<column name="paid_date" type="char" size="14" />
	<column name="cancelled_date" type="char" size="14" />
	<!-- 무통장 입금 기한. 지난 주문을 만료 처리할 때 훑는 기준이라 인덱스를 건다. -->
	<column name="due_date" type="char" size="14" index="idx_due_date" />

	<!--
	  요청자가 자기 주문의 결제를 찾을 때 항상 이 두 칼럼을 함께 쓴다.
	  (PayService::getOrderBySource) 그래서 복합으로 건다.
	-->
	<index name="idx_source" columns="source_module,source_srl" />
</table>
