<table name="zittme_pay_log">
	<!--
	  결제 관련 요청·응답을 하나도 빠짐없이 남긴다. (보안 3원칙 3)
	  분쟁이 붙으면 "우리가 PG 에 무엇을 보냈고 무엇을 받았는가" 를 대는 것 말고는
	  방법이 없다. 승인 실패·금액 불일치·중복 콜백도 전부 여기 남는다.
	-->
	<column name="log_srl" type="bigint" notnull="notnull" primarykey="primarykey" />
	<column name="order_srl" type="bigint" notnull="notnull" default="0" index="idx_order_srl" />
	<column name="order_code" type="varchar" size="40" />
	<column name="gateway" type="varchar" size="20" />
	<!-- ready / request / approve / cancel / webhook / query / expire -->
	<column name="action" type="varchar" size="20" notnull="notnull" default="" index="idx_action" />
	<column name="request_data" type="text" />
	<column name="response_data" type="text" />
	<!-- S: 성공 / F: 실패 -->
	<column name="result" type="char" size="1" notnull="notnull" default="S" />
	<column name="pg_tid" type="varchar" size="120" />
	<column name="amount" type="bigint" notnull="notnull" default="0" />
	<column name="ipaddress" type="varchar" size="128" />
	<column name="regdate" type="char" size="14" index="idx_regdate" />
</table>
