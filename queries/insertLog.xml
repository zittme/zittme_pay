<query id="insertLog" action="insert">
	<tables>
		<table name="zittme_pay_log" />
	</tables>
	<columns>
		<column name="log_srl" var="log_srl" notnull="notnull" />
		<column name="order_srl" var="order_srl" default="0" />
		<column name="order_code" var="order_code" />
		<column name="gateway" var="gateway" />
		<column name="action" var="action" notnull="notnull" />
		<column name="request_data" var="request_data" />
		<column name="response_data" var="response_data" />
		<column name="result" var="result" default="S" />
		<column name="pg_tid" var="pg_tid" />
		<column name="amount" var="amount" default="0" />
		<column name="ipaddress" var="ipaddress" />
		<column name="regdate" var="regdate" />
	</columns>
</query>
