<query id="updateOrderStatusIf" action="update">
	<!--
	  멱등성의 핵심.

	  "지금 상태가 from_status_list 중 하나일 때만" 새 상태로 옮긴다. 상태 검사와 상태 변경이
	  한 문장 안에서 원자적으로 일어나므로, 콜백과 웹훅이 동시에 도착해도 둘 중 하나만 이긴다.
	  진짜로 바뀌었는지는 호출부가 DB::getAffectedRows() 로 판정한다 — 1 이면 내가 이겼고,
	  0 이면 이미 다른 요청이 처리한 것이라 로그만 남기고 조용히 물러난다.

	  PHP 에서 "읽어서 확인하고 → 쓰기" 로 나눠 하면 그 사이에 다른 요청이 끼어들어
	  중복 승인·중복 트리거가 난다. 그래서 반드시 이 쿼리를 쓴다.
	-->
	<tables>
		<table name="zittme_pay_order" />
	</tables>
	<columns>
		<column name="status" var="status" notnull="notnull" />
		<column name="paid_date" var="paid_date" />
		<column name="cancelled_date" var="cancelled_date" />
		<column name="confirm_date" var="confirm_date" />
		<column name="pg_tid" var="pg_tid" />
		<column name="pay_method" var="pay_method" />
		<column name="gateway" var="gateway" />
		<column name="extra_vars" var="extra_vars" />
		<column name="due_date" var="due_date" />
	</columns>
	<conditions>
		<condition operation="equal" column="order_srl" var="order_srl" required="true" />
		<condition operation="in" column="status" var="from_status_list" pipe="and" required="true" />
	</conditions>
</query>
