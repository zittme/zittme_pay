<query id="insertOrder" action="insert">
	<tables>
		<table name="zittme_pay_order" />
	</tables>
	<columns>
		<column name="order_srl" var="order_srl" notnull="notnull" />
		<column name="order_code" var="order_code" notnull="notnull" />
		<column name="source_module" var="source_module" notnull="notnull" />
		<column name="source_srl" var="source_srl" default="0" />
		<column name="member_srl" var="member_srl" default="0" />
		<column name="payer_name" var="payer_name" />
		<column name="payer_phone" var="payer_phone" />
		<column name="payer_email" var="payer_email" />
		<column name="title" var="title" />
		<column name="currency" var="currency" default="KRW" />
		<column name="amount" var="amount" default="0" />
		<column name="cancelled_amount" var="cancelled_amount" default="0" />
		<column name="gateway" var="gateway" />
		<column name="pay_method" var="pay_method" />
		<column name="pg_tid" var="pg_tid" />
		<column name="status" var="status" default="ready" />
		<column name="return_url" var="return_url" />
		<column name="ipaddress" var="ipaddress" />
		<column name="extra_vars" var="extra_vars" />
		<column name="regdate" var="regdate" />
		<column name="due_date" var="due_date" />
	</columns>
</query>
